<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_eco_brain"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Logo actualizado (Asegúrate de guardar la imagen como logo_ecobrain.png en res/drawable) -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/logo_ecobrain"
        android:layout_marginBottom="8dp" />

    <!-- Inputs Estilizados -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glow_border"
        android:hint="ID Estudiantil / Correo"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:padding="16dp"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glow_border"
        android:hint="Contraseña de Acceso"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:padding="16dp"
        android:inputType="textPassword"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AUTENTICAR SISTEMA"
        android:backgroundTint="@color/cyan_neon"
        android:textColor="@color/background_dark"
        android:textStyle="bold"
        android:padding="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Terminal de Acceso EcoBrain IA"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <!-- Leyenda de Derechos Reservados -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="© 2024 EcoBrain IA - Derechos Reservados"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:alpha="0.7"/>

</LinearLayout>